  m_Name: 
  m_EditorClassIdentifier: 
  responseType: 1
  emailName: Manager
  header: Training 1
  requestMessage: "Hey, man, this is where I ask whether something is true or not,
    right? So listen up. I\u2019m pretty sure my friend here just got scammed. He
    paid to adopt this creature, and it\u2019s totally not legit. I mean, like, no
    way, right? The animal it describes just cannot exist. Can you help me win my
    bet by telling me whether this advert article, called \u201CAdopt Your Evolutionary
    Freak Today,\u201D is false or whatever?\r\n\r\n<align=\"center\"><b>The article
    in question:</b>\r\nAdopt Your Evolutionary Freak Today</align>\r\n\r\nReferences:\r\nA.M.N.H.
    (2024). Monotremes. The Australian Museum of Natural History.\r\nAustralian Government.
    (2016). Platypus | discovering wildlife.\r\nNer, D. (2020). Biofluorescence in
    Ornithorhynchus anatinus. Mammalia.\r\n"
  nameText: {fileID: 582348565}
  requestTitle: {fileID: 263703437}
  hasResponded: 0
  profileImage: {fileID: 0}
  profile: {fileID: 0}
  index: 5
  waitTime: 2

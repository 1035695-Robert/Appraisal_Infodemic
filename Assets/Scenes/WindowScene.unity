  isRequest: 0
  emailName: Boss
  header: Welcome Employees
  requestMessage: "To [/<error: could not retrieve \u2018Name\u2019 for employee,
    ID No.1035365>]\n\nI must inform you that our company\u2019s analytical AI is
    currently offline due to unscheduled emergency maintenance. As a result, it can
    no longer process verification requests for our clientele. Naturally, we cannot
    make this matter public, as transparency would pose an unacceptable risk to our
    company's prestigious reputation and our stakeholders' investment portfolio.
    Accordingly, you have been selected because of your [below-average performance]
    to complete verification requests for our company\u2019s clients. Please treat
    this assignment with the seriousness it deserves; your continued employment will
    be reviewed against your performance metrics upon completion of this task.\n\nThank
    you for your mandatory compliance,\nThe Boss"
  nameText: {fileID: 5493019754712275163}
  requestTitle: {fileID: 5660581172935829349}

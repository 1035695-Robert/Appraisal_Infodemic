  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The platypus (Ornithorhynchus anatinus) sounds like an animal assembled
    from several unrelated species, yet it is entirely real. Native to Australia,
    this furry, semi-aquatic mammal has a duck-like bill, a beaver-like tail, and
    webbed feet. It is one of only five monotreme species still alive today.\n\r\nMales
    have venomous spurs on their hind legs, and the venom can cause severe, prolonged
    pain in humans, making the platypus one of the very few venomous mammals.\r\nFemales
    are just as remarkable: instead of giving birth to live young, they lay eggs.
    The surprises don't stop there. Female platypuses produce milk to feed their
    babies, even though they have no nipples. Instead, the milk seeps through pores
    in their skin, and the young drink it from their mother\u2019s fur.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}

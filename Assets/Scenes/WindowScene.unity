  m_Script: {fileID: 11500000, guid: 7fc7e4668d5e66446b840e1825c1ee0d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  responseType: 1
  emailName: Manager
  header: Training 1
  requestMessage: "Hey, can you verify the information in this message from my manager?
    I work at a 6/12 petrol station with a mate of mine called Tom, and he just tried
    this and said it didn\u2019t work, and the manager thinks he just did it wrong.
    Can you tell me if the Mpemba effect is real, and whether it always works?\r\n\r\nThe
    Message in question:\r\nNotification to all 6/12 staff members\r\n\r\nReferences\r\nBe
    Smart. (2026). The Very Weird Reason Hot Water Freezes Faster [Video]. YouTube.
    https://www.youtube.com/watch?v=KLmtn_xwgS4\r\nBurridge, H. C., & Hallstadius,
    O. (2020). Observing the Mpemba effect with minimal bias and the value of the
    Mpemba effect to scientific outreach and engagement. Proc. R. Soc. A, 476(2241),
    20190829. https://doi.org/10.1098/rspa.2019.0829\r\nTom. (2026). Conversation
    between Tom and Eric. [Discussion]. ChatApp.\r\n"
  nameText: {fileID: 905905188}
  requestTitle: {fileID: 902804008}
  hasResponded: 0
  profileImage: {fileID: 0}
  profile: {fileID: 0}
  index: 6
  waitTime: 2

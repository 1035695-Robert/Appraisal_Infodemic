  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Welcome to the Office of Verified Truth, sometimes known as O.V.T. for
    short.\r\n\r\nYou\u2019ve joined a team of honourable, hardworking analysts dedicated
    to helping stop the infodemic plague our society is facing.\nWhile you do have
    superiors here, our company believes in the corporate family model, which encourages
    equality. So please don\u2019t assume it\u2019s your responsibility to simply
    complete all work handed down by your superiors without question.\r\n\r\nAt one
    point in the past, research showed that unquestioning compliance could lead to
    blissful satisfaction; however, evolving psychoanalysis later found that these
    two phenomena were not actually as closely linked as previously thought.\r\n\r\nHere
    at the Office of Verified Truth, we\u2019re committed to not repeating the mistakes
    of the past and to continually striving for a better tomorrow for our company,
    our family, and our society as a whole.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}

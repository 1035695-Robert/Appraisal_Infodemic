  m_Name: 
  m_EditorClassIdentifier: 
  responseType: 0
  emailName: Manager
  header: Manager Automated Response
  requestMessage: "Hello esteemed employee,\r\n\r\nThis is a formal follow-up regarding
    the matter presently under your care, which Sir Manager previously supervised
    with the highest distinction. Regrettably, Sir Manager's scheduled golf engagement
    with the Boss is now imminent, and he was therefore obliged to depart early so
    as not to keep the Boss waiting under any circumstances.\n\nAccordingly, he will
    be unable to provide any further assistance with your current task. I have been
    instructed to advise you that your training has been completed, and that you
    are now to proceed with the task properly and without further delay. I have also
    been informed that this task is of the utmost importance, and you are accordingly
    expected to execute it with utmost care, as any mistake would be most unfortunate
    and may affect any future career opportunities to which you may otherwise be
    entitled.\r\n\r\nWishing you a prosperous career and future,\r\nSir Manager\u2019s
    Secretary.\r\n"
  nameText: {fileID: 1980085430}
  requestTitle: {fileID: 760715435}
  hasResponded: 0
  profileImage: {fileID: 0}
  profile: {fileID: 0}
  index: 4
  waitTime: 2

  m_Script: {fileID: 11500000, guid: 7fc7e4668d5e66446b840e1825c1ee0d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  isRequest: 0
  emailName: Manager
  header: Training 101
  requestMessage: "Before you begin,\n\nI think the best way for you to learn the
    difference between these three key points is to play a little game that will
    teach you the difference. Ever heard of the game Two Truths and a Lie? Well,
    I\u2019ve modified it a little bit. Now you\u2019ll find it\u2019s two lies and
    a truth. But the two lies are different: one is misinformation, and the other
    is disinformation. Think you\u2019ll be able to tell the difference?\n\n Let\u2019s
    find out. I\u2019m sending you 3 requests for verification now.\n\nGenius game
    master,\nSir. Manager"
  nameText: {fileID: 1256693965}
  requestTitle: {fileID: 1291638231}
